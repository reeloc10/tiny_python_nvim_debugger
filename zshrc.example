# ~/.zshrc (Example)
# Minimal Zsh configuration for Fedora 45 workspace

# Fedora 45 requirements:
# zsh
# zsh-autosuggestions
# zsh-syntax-highlighting

# History configuration
# Lines configured by zsh-newuser-install
HISTFILE=~/.histfile
HISTSIZE=100000
SAVEHIST=100000
# End of lines configured by zsh-newuser-install

# Appends your newly entered commands instead of overwriting
setopt appendhistory
# Imports commands typed in other windows into your current session on the fly.
setopt sharehistory

# Basic completion styling
autoload -Uz compinit
compinit

# Enable menu-driven completion and case-insensitive matching
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

# Group completion matches cleanly
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '%F{yellow}-- %d --%f'

# Explicitly set comment color for zsh-syntax-highlighting
typeset -A ZSH_HIGHLIGHT_STYLES
ZSH_HIGHLIGHT_STYLES[comment]='fg=244'

# Fedora/Vi-mode default: "^R" redisplay
# "^R" and "^r" are identical ASCII control characters (0x12)
# zsh incremental search is smart-case (case-insensitive unless uppercase is typed)
bindkey '^R' history-incremental-search-backward

# Accept suggestion with right arrow
bindkey '^[[C' forward-word

# Enable prompt substitution and colors
autoload -U colors && colors

# Load Fedora system plugins if installed via RPM
if [ -f /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]; then
    source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
fi

if [ -f /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]; then
    source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi

# Example prompt: green user@host in blue directory, with current branch
# Load version control information module
autoload -Uz vcs_info
precmd() { vcs_info }

# Format the vcs_info output (displays git branch)
zstyle ':vcs_info:git:*' formats ' (%b)'
zstyle ':vcs_info:*' enable git

# Include ${vcs_info_msg_0_} in your PROMPT
setopt prompt_subst
PROMPT='%{$fg[green]%}[%n@%m]%{$reset_color%}:%{$fg[blue]%}%~%{$reset_color%}%{$fg[yellow]%}${vcs_info_msg_0_}%{$reset_color%}%# '

# nvim -u safeguard
nvim() {
  local args=("$@")
  for ((i=1; i<=$#; i++)); do
    if [[ "${args[i]}" == "-u" ]]; then
      local target="${args[i+1]}"
      if [[ -n "$target" ]]; then
        # Check if the target is a file and ends with .lua or .vim
        if [[ -f "$target" && "$target" != *.lua && "$target" != *.vim ]]; then
          print -P "%F{red}nvim: error: initialization file %{$reset_color%}'$target'%F{red} is not a valid .lua or .vim config.%f" >&2
          return 1
        fi
      fi
      break
    fi
  done
  command nvim "$@"
}
